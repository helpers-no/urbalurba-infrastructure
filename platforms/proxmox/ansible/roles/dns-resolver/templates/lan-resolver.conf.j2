# GENERATED by roles/dns-resolver (templates/lan-resolver.conf.j2). Do not hand-edit: the next
# role run overwrites it. Change config.sh / generate-ansible-config.sh instead.

# ── this guest's own interface only — never every interface on the box ──────────────────────
# `interface=` alone: dnsmasq's manpage says `listen-address` "is a stronger constraint than
# interface" — stacking both made dnsmasq try to bind the wildcard address twice against itself.
# `interface` alone binds once and filters by interface via IP_PKTINFO, the documented default.
interface=eth0

# ── the zone this resolver is actually for ───────────────────────────────────────────────────
domain={{ dns_resolver_domain }}
local=/{{ dns_resolver_domain }}/
expand-hosts
addn-hosts={{ dns_resolver_zone_path }}

# ── everything else forwards upstream — this resolver ADDS names, it does not replace DNS ──
# no-resolv: never read /etc/resolv.conf for upstream servers — without it dnsmasq would also
# forward through whatever this guest's own DHCP lease handed it, silently doubling forwarders.
no-resolv
server={{ dns_resolver_upstream }}

cache-size={{ dns_resolver_cache_size }}

# don't act as a TFTP/DHCP server — this guest is a resolver only
no-dhcp-interface=eth0
