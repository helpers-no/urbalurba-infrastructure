; MANAGED BY ANSIBLE — roles/forgejo/templates/app.ini.j2. Local edits are lost on the next run.
;
; SECRET_KEY/INTERNAL_TOKEN are deliberately NOT generated by this template — a value baked in
; here would be overwritten (and therefore silently rotated, breaking every existing session and
; signed cookie) on every single role run, since this whole file is replaced each time. They come
; in as required variables instead, generated once:
;   docker run --rm {{ forgejo_image }} forgejo generate secret SECRET_KEY
;   docker run --rm {{ forgejo_image }} forgejo generate secret INTERNAL_TOKEN
; same "supplied at run time, never declared" rule as garage's bootstrap credential.

APP_NAME = Forgejo
RUN_MODE = prod
RUN_USER = git

[server]
DOMAIN           = {{ forgejo_domain }}
ROOT_URL         = {{ forgejo_root_url }}
HTTP_PORT        = {{ forgejo_http_port }}
SSH_DOMAIN       = {{ forgejo_domain }}
; 🔴 SSH_PORT is what Forgejo TELLS CLIENTS (clone URLs); it is not what it binds. The standard
; (non-rootless) image runs a system sshd for git-ssh via a forced command; Forgejo's own built-in
; Go SSH server would bind the same container port 22 and collide with it if enabled — so
; START_SSH_SERVER stays Forgejo's own default (false) rather than true.
SSH_PORT         = {{ forgejo_ssh_port }}
START_SSH_SERVER = false
DISABLE_SSH      = false

[database]
; sqlite — a single-node install. Revisit if/when this guest outgrows it, same deferred-decision
; shape as roles/garage's own db_engine: sqlite note.
; 🔵 /data IS THE CONTAINER'S OWN PATH, not the host's — the host's {{ forgejo_data_dir }} is
; bind-mounted to /data inside the container (see the systemd unit), and every path below is
; written as the container sees it, the official image's own layout.
DB_TYPE = sqlite3
PATH    = /data/gitea/forgejo.db

[security]
; Disables the interactive web installer — this file IS the install, same principle as
; garage/bao shipping no manual setup step. Does not disable Forgejo's own automatic DB migration
; on startup, which still runs regardless.
INSTALL_LOCK   = true
SECRET_KEY     = {{ forgejo_secret_key }}
INTERNAL_TOKEN = {{ forgejo_internal_token }}

[oauth2]
; Without this, Forgejo tries to self-generate and write this key back into app.ini on every
; startup — and fails outright, since this file is deliberately mounted read-only (see the
; systemd unit). Same "supplied at run time, never left to auto-generate into a file we overwrite"
; rule as SECRET_KEY/INTERNAL_TOKEN above.
JWT_SECRET = {{ forgejo_jwt_secret }}

[repository]
ROOT = /data/git/repositories

[log]
MODE  = console
LEVEL = Info

[packages]
; Forgejo's own built-in OCI registry — what UIS/Epinio builds get pushed to.
ENABLED = true
