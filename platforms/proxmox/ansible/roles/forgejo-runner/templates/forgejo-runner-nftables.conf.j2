#!/usr/sbin/nft -f
# MANAGED BY ANSIBLE — roles/forgejo-runner/templates/forgejo-runner-nftables.conf.j2. Local
# edits are lost on the next run.
#
# This guest runs CI build jobs: semi-trusted code by design. The goal is enforcing "no reach
# into this lab's real data/secrets" as a network control, not a procedural promise. See
# roles/forgejo-runner/tasks/main.yml's own firewall section for the full reasoning, including
# why this is a DENY-list (not an allow-list).
#
# 🔴 SSH IS UNSCOPED, DELIBERATELY — same convention as every other guest's role here (bao/garage/
# nas: "SSH and outbound traffic are unaffected"). This guest has no service port of its own to
# protect — it polls Forgejo outbound, nothing listens.
#
# 🔴 `destroy table`, NOT `flush ruleset` — found live on the reference lab, the hard way, and
# the single most important line in this file. This guest's ENTIRE job is running Docker
# containers (Forgejo Runner itself, and every build job it executes), and Docker keeps its own
# `ip nat`/`ip filter` tables for its bridge's masquerade rule — invisible in this file but
# essential for ANY container to reach anything off its own bridge subnet. `flush ruleset` is a
# GLOBAL flush, every table, every family — the same anti-pattern roles/garage's own header warns
# about by name. It stays invisible until Docker is actually installed on this guest (which this
# role's own earlier tasks do, before this template is ever rendered) — the moment it is, a
# `flush ruleset` here would wipe Docker's masquerade rule along with everything else, and every
# container on this guest would silently lose all network access, not just to the denied
# addresses. `destroy table inet filter` is scoped to this one named table, a no-op the first
# time it doesn't exist, and leaves Docker's own tables alone.
destroy table inet filter

table inet filter {
	chain input {
		type filter hook input priority 0; policy drop;

		iif lo accept
		ct state established,related accept
		ip protocol icmp accept
		ip6 nexthdr icmpv6 accept
		tcp dport 22 accept
	}

	# 🔴 POLICY ACCEPT, NOT DROP — this guest's whole JOB is running Docker containers (Forgejo
	# Runner itself, and every build job it executes), and a CONTAINER's own outbound traffic to
	# the LAN transits `forward` on the host, never `output` — `output` only ever sees traffic the
	# HOST ITSELF originates. Leaving `forward` at `policy drop` with no rules at all would
	# silently block every container's egress entirely, including Forgejo Runner's own
	# registration call. Same deny-list as `output` below, applied here too, so
	# container-originated traffic is held to the identical rule as the host's own.
	chain forward {
		type filter hook forward priority 0; policy accept;

{% for addr in forgejo_runner_firewall_deny_addrs %}
		ip daddr {{ addr }} drop
{% endfor %}
	}

	# Default accept, explicit deny — every other guest/host this platform currently knows about
	# is blocked (see generate-ansible-config.sh's own comment for exactly what that list is and
	# why); Forgejo itself, the internet, and build dependencies are left open. Enumerating every
	# legitimate build-time destination is not attempted here — a narrow allow-list would just
	# become a stream of false negatives.
	chain output {
		type filter hook output priority 0; policy accept;

		ct state established,related accept
{% for addr in forgejo_runner_firewall_deny_addrs %}
		ip daddr {{ addr }} drop
{% endfor %}
	}
}
