# {{ ansible_managed }}
# One templated unit, four instances. 🔴 This replaces four hand-run `docker run` commands that
# existed nowhere on disk — kept alive only by `restart: always`, so removing one left no record
# of how to recreate it. Measured on odin 2026-10-01.
[Unit]
Description=Pull-through image cache: %i
Requires=docker.service
After=docker.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=10
EnvironmentFile={{ registry_data_root }}/%i.env
# --rm so a restart never collides with a stale container of the same name; the DATA lives in
# the bind mount, not the container, so nothing is lost.
ExecStartPre=-/usr/bin/docker rm -f mirror-%i
ExecStart=/usr/bin/docker run --rm --name mirror-%i \
  -p ${MIRROR_PORT}:5000 \
  --memory {{ registry_mem_limit }} --cpus {{ registry_cpu_limit }} \
  --log-opt max-size={{ registry_log_max_size }} --log-opt max-file={{ registry_log_max_file }} \
  -v {{ registry_data_root }}/mirror-%i:/var/lib/registry \
  -e REGISTRY_PROXY_REMOTEURL=${MIRROR_UPSTREAM} \
  -e REGISTRY_STORAGE_DELETE_ENABLED=true \
{% if registry_metrics_enabled %}
  -p ${MIRROR_METRICS_PORT}:5001 \
  -e REGISTRY_HTTP_DEBUG_ADDR=0.0.0.0:5001 \
  -e REGISTRY_HTTP_DEBUG_PROMETHEUS_ENABLED=true \
  -e REGISTRY_HTTP_DEBUG_PROMETHEUS_PATH=/metrics \
{% endif %}
  {{ registry_image }}
ExecStop=/usr/bin/docker stop mirror-%i

[Install]
WantedBy=multi-user.target
