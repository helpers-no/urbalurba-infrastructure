{#
  040-postgresql-external-proxy.yml.j2

  Rendered INSTEAD of deploying PostgreSQL in-cluster, when this installation
  declares in .uis.extend/external-services.yaml that it already has one.

  ⚠️ THE POINT IS THAT NOTHING DOWNSTREAM KNOWS THE DIFFERENCE.
  Every property below is load-bearing for that, and each was learned by running
  it in production. Read before changing:

    * the Deployment and Service carry the REAL service's name and labels, so
      SCRIPT_CHECK_COMMAND and `uis list` work unchanged
    * the FIRST container is a postgres image, so playbooks that `kubectl exec`
      into "the postgres pod" to run psql work unchanged
    * Service/postgresql means PGHOST=postgresql.default resolves identically in
      both topologies, so openwebui, gravitee, temporal, unity-catalog and
      openmetadata are untouched

  Extra-vars (underscore-prefixed, per ansible/playbooks/templates/README.md):
    _external_host   address of the real database (see the note on addresses)
    _external_port   its port (default 5432)
    namespace        target namespace (default "default")
-#}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgresql
  namespace: {{ namespace | default('default') }}
  labels: { app.kubernetes.io/name: postgresql }
spec:
  replicas: 1
  selector:
    matchLabels: { app.kubernetes.io/name: postgresql }
  template:
    metadata:
      labels: { app.kubernetes.io/name: postgresql }
    spec:
      containers:
        # FIRST container = what `kubectl exec` targets. Provides bash + psql
        # so UIS playbooks that exec into "the postgres pod" work unchanged.
        - name: postgresql
          image: postgres:18
          command: ["sleep","infinity"]
          resources:
            requests: { cpu: 10m, memory: 32Mi }
            limits: { cpu: 500m, memory: 256Mi }
        # Forwards the pod's :{{ _external_port | default(5432) }} to the real external database.
        #
        # ⚠️ PREFER A BACKPLANE ADDRESS OVER A TAILNET ONE where the database and
        # the cluster sit on the same host. On the reference installation this is
        # 10.10.0.105 (CT 105 over the host-only bridge vmbr1), deliberately not
        # the tailnet address: that traffic must not depend on WireGuard or on
        # Tailscale's coordination server being reachable. See
        # docs: odin-backplane-network.md
        - name: socat
          image: alpine/socat:1.8.0.0
          args: ["TCP-LISTEN:{{ _external_port | default(5432) }},fork,reuseaddr","TCP:{{ _external_host }}:{{ _external_port | default(5432) }}"]
          ports: [{ containerPort: {{ _external_port | default(5432) }}, name: tcp-postgresql }]
          readinessProbe:
            tcpSocket: { port: {{ _external_port | default(5432) }} }
            initialDelaySeconds: 3
          resources:
            requests: { cpu: 10m, memory: 16Mi }
            limits: { cpu: 200m, memory: 64Mi }
---
apiVersion: v1
kind: Service
metadata:
  name: postgresql
  namespace: {{ namespace | default('default') }}
  labels: { app.kubernetes.io/name: postgresql }
spec:
  type: ClusterIP
  selector: { app.kubernetes.io/name: postgresql }
  ports:
    - name: tcp-postgresql
      port: {{ _external_port | default(5432) }}
      targetPort: {{ _external_port | default(5432) }}
