#!/bin/bash
# UIS - Urbalurba Infrastructure Stack CLI wrapper
# This script manages the UIS provision-host container
#
# Usage: ./uis <command> [args]
# Run ./uis help for available commands

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTAINER_NAME="uis-provision-host"
IMAGE="${UIS_IMAGE:-ghcr.io/helpers-no/uis-provision-host:latest}"
KUBECONFIG_DIR="${UIS_KUBECONFIG_DIR:-$HOME/.kube}"

# ---------------------------------------------------------------------------
# Environment forwarded into the container
#
# ⚠️ `docker exec` does NOT inherit the caller's environment. A variable set on
# the host simply does not exist inside, silently — so any documented override
# that is not listed here is a NO-OP that looks like it worked.
#
# That happened: the dispatch for a test told the tester to run
#   PG_PSQL_HOST=10.255.255.1 ./uis configure postgrest ...
# and every psql call went to the default anyway. The run SUCCEEDED, which
# reads as "the tool handled a dead host fine" rather than "the override never
# arrived". A test whose failure mode is indistinguishable from success is not
# a test.
#
# Add a variable here when the code inside the container reads it and an
# operator is meant to be able to set it. Keep it an allow-list rather than
# forwarding the whole environment: the container should not inherit whatever
# happens to be exported on someone's laptop.
UIS_FORWARDED_ENV=(
    PG_PSQL_HOST            # lib/pg-connection.sh — how UIS reaches postgres
    UIS_VERIFY_KUBECONFIG   # lib/verify-target.sh — which kubeconfig verifies read
    UIS_TARGET_HOST         # which cluster `./uis verify` asks. VERIFY ONLY —
                            # deploy/undeploy act on the ACTIVE kubectl context
                            # and refuse if this disagrees with it.
)

# TARGET_HOST is the name an operator naturally reaches for, but the container's
# cluster-config.sh assigns TARGET_HOST unconditionally and would overwrite it.
# Accept the friendly name here and forward it under the one the container
# honours. Setting UIS_TARGET_HOST directly also works.
if [ -n "${TARGET_HOST+x}" ] && [ -z "${UIS_TARGET_HOST+x}" ]; then
    UIS_TARGET_HOST="$TARGET_HOST"
fi

# Build the `-e NAME=value` arguments for those that are actually set, so an
# unset variable stays unset inside rather than becoming an empty string.
build_env_args() {
    ENV_ARGS=()
    local name
    for name in "${UIS_FORWARDED_ENV[@]}"; do
        if [ -n "${!name+x}" ]; then
            ENV_ARGS+=(-e "$name=${!name}")
        fi
    done
}
build_env_args

# Detect TTY for docker exec flags
# -it for interactive terminal, -i only for piped stdin (still forwards input)
if [ -t 0 ] && [ -t 1 ]; then
    DOCKER_IT="-it"
else
    DOCKER_IT="-i"
fi

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[UIS]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[UIS]${NC} $1"; }
log_error() { echo -e "${RED}[UIS]${NC} $1"; }

# Check if image exists, pull if needed
check_image() {
    if docker image inspect "$IMAGE" &>/dev/null; then
        return 0
    fi

    # Image not found locally - try to pull if it looks like a registry image
    if [[ "$IMAGE" == *"/"* ]]; then
        log_info "Image '$IMAGE' not found locally, pulling from registry..."
        if docker pull "$IMAGE"; then
            log_info "Image pulled successfully"
            return 0
        fi
        log_error "Failed to pull image '$IMAGE'"
    else
        log_error "Image '$IMAGE' not found!"
    fi

    log_info "Build it with: docker build -f Dockerfile.uis-provision-host -t uis-provision-host:local ."
    log_info "Or pull from registry: export UIS_IMAGE=ghcr.io/helpers-no/uis-provision-host:latest"
    exit 1
}

# Create config directories on first run
init_config_dirs() {
    local first_run=false

    # Create .uis.extend if it doesn't exist
    if [ ! -d "$SCRIPT_DIR/.uis.extend" ]; then
        log_info "Creating .uis.extend/ configuration directory..." >&2
        mkdir -p "$SCRIPT_DIR/.uis.extend"
        first_run=true
    fi

    # Create .uis.secrets if it doesn't exist
    if [ ! -d "$SCRIPT_DIR/.uis.secrets" ]; then
        log_info "Creating .uis.secrets/ directory..." >&2
        mkdir -p "$SCRIPT_DIR/.uis.secrets"
        first_run=true
    fi

    # Ensure .uis.secrets is in .gitignore (create file if needed)
    if [ ! -f "$SCRIPT_DIR/.gitignore" ]; then
        # Create .gitignore with .uis.secrets entry
        echo "# UIS secrets - do not commit" > "$SCRIPT_DIR/.gitignore"
        echo ".uis.secrets/" >> "$SCRIPT_DIR/.gitignore"
        log_info "Created .gitignore with .uis.secrets/" >&2
    elif ! grep -q "^\.uis\.secrets" "$SCRIPT_DIR/.gitignore" 2>/dev/null; then
        # Append to existing .gitignore
        echo "" >> "$SCRIPT_DIR/.gitignore"
        echo "# UIS secrets (auto-added)" >> "$SCRIPT_DIR/.gitignore"
        echo ".uis.secrets/" >> "$SCRIPT_DIR/.gitignore"
        log_info "Added .uis.secrets/ to .gitignore" >&2
    fi

    # Return first_run status for welcome message (shown after container starts)
    echo "$first_run"
}

# Show welcome message from inside container
show_welcome() {
    docker exec "$CONTAINER_NAME" bash -c '
        if [ -f /mnt/urbalurbadisk/provision-host/uis/templates/welcome.txt ]; then
            cat /mnt/urbalurbadisk/provision-host/uis/templates/welcome.txt
        fi
    ' 2>/dev/null || true
}

# Start container if not running
start_container() {
    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        return 0
    fi

    check_image
    local first_run
    first_run=$(init_config_dirs)

    log_info "Starting UIS container..."

    # Remove old container if exists
    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true

    # Build volume mount arguments
    local VOLUME_ARGS=(
        -v "$SCRIPT_DIR/.uis.extend:/mnt/urbalurbadisk/.uis.extend"
        -v "$SCRIPT_DIR/.uis.secrets:/mnt/urbalurbadisk/.uis.secrets"
    )

    # Add kubeconfig mount if it exists
    # On WSL, ~/.kube/config is often a symlink to a Windows path - Docker cannot
    # follow the symlink inside the container, so we resolve it and mount the file directly.
    # On Linux/Mac where config is a real file, behavior is unchanged.
    if [ -d "$KUBECONFIG_DIR" ]; then
        local kubeconfig_file="$KUBECONFIG_DIR/config"
        if [ -L "$kubeconfig_file" ]; then
            local resolved
            resolved="$(readlink -f "$kubeconfig_file" 2>/dev/null)"
            if [ -f "$resolved" ]; then
                log_info "Resolved kubeconfig symlink to: $resolved"
                VOLUME_ARGS+=(-v "$resolved:/home/ansible/.kube/config:ro")
            else
                VOLUME_ARGS+=(-v "$KUBECONFIG_DIR:/home/ansible/.kube:ro")
            fi
        else
            VOLUME_ARGS+=(-v "$KUBECONFIG_DIR:/home/ansible/.kube:ro")
        fi
    else
        log_warn "Kubeconfig directory not found: $KUBECONFIG_DIR"
        log_warn "Kubernetes commands will not work until kubeconfig is configured"
    fi

    # Start with host network (so 127.0.0.1 in kubeconfig works)
    # This matches how the original provision-host container was configured
    docker run -d --name "$CONTAINER_NAME" \
        --network host \
        --privileged \
        "${VOLUME_ARGS[@]}" \
        "$IMAGE"

    # Wait for container to be ready
    sleep 2

    # Put the host kubeconfig where the ~100 ansible playbooks read it.
    #
    # ⚠️ A REAL FILE, NOT A SYMLINK — and this line is why.
    #
    # This used to be `ln -sf /home/ansible/.kube/config <path>`. That symlink
    # points into the container's own home, which cannot be read back through
    # the bind mount: kubectl reports "operation not permitted". Every ansible
    # playbook reads that path, so EVERY verify failed — and failed by blaming
    # the service it was verifying, not the config.
    #
    # It ran on every `./uis start`, so restarting the container did not repair
    # the state, it RE-CREATED it. Container-side code that fixed the path was
    # undone by the next start. Found by the independent tester (2026-08-25),
    # who was following remediation advice that told them to restart.
    #
    # Errors are reported rather than swallowed: a silent failure here breaks
    # everything downstream and points nowhere.
    docker exec "$CONTAINER_NAME" bash -c '
        set -e
        KC_DIR=/mnt/urbalurbadisk/.uis.secrets/generated/kubeconfig
        KC="$KC_DIR/kubeconf-all"
        [ -d /mnt/urbalurbadisk/.uis.secrets ] || exit 0
        mkdir -p "$KC_DIR"
        if [ -f /home/ansible/.kube/config ]; then
            # --remove-destination replaces a symlink left by an older launcher
            # instead of following it into the unwritable target.
            cp --remove-destination /home/ansible/.kube/config "$KC" || exit 1
            chmod 600 "$KC" || true
        fi
        # Assert the outcome, not the command.
        if [ -L "$KC" ] || [ ! -r "$KC" ]; then
            echo "WARNING: $KC is not a readable regular file." >&2
            echo "         Ansible playbooks read it; kubectl will fail for all of them." >&2
            exit 1
        fi
    ' || log_info "WARNING: could not write the merged kubeconfig; verifies may fail"

    log_info "Container started"

    # Initialize config files on first run
    if [ "$first_run" = "true" ]; then
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh init 2>/dev/null || true
        show_welcome
    fi
}

# Pull latest container image and restart
# Remove UIS images this machine no longer needs.
#
# ⚠️ `./uis pull` used to leave every superseded image on disk. Each is ~1.2 GB,
# and the machine that pulls most often is the one building UIS — so the
# maintainer's own box fills first. On a 29 GB Pi that is about a fortnight.
#
# It filled assist's disk on 2026-08-25: 18 images, 12.9 GB, 9 GB reclaimable.
# k3s taints a node at ~10% free, so the node tainted itself, and the pods that
# went Pending included Uptime Kuma — the fleet's watchdog, down six hours
# before anyone noticed. The thing that would have reported it was the thing
# that was down.
#
# Rules, in order of importance:
#   1. NEVER remove an image a container is using. `docker rmi` already refuses,
#      so this deliberately does NOT pass -f. If an image is in use, leaving it
#      is the correct outcome and the loop moves on.
#   2. Keep the image the current container runs, plus whatever :latest now
#      resolves to. Those can differ for a moment during a restart.
#   3. Say what was freed. Silent cleanup is how people stop trusting cleanup.
cleanup_old_images() {
    local repo="${IMAGE%%:*}"
    local keep_ids="" freed=0 removed=0

    # What must survive: what :latest points at, and what the container runs.
    local latest_id running_id
    latest_id="$(docker image inspect "$IMAGE" --format '{{.Id}}' 2>/dev/null || true)"
    running_id="$(docker inspect "$CONTAINER_NAME" --format '{{.Image}}' 2>/dev/null || true)"
    keep_ids="$latest_id $running_id"

    # ⚠️ TWO ENUMERATIONS, UNIONED. Neither alone is sufficient.
    #
    # `docker images <repo>` lists images that still carry that REPOSITORY
    # NAME. That is the one this used to use, and its comment claimed "tagged or
    # dangling" - which the command does not deliver. When `:latest` moves, the
    # superseded image can lose its repository association entirely and become
    # <none>:<none>, at which point this filter never sees it again.
    #
    # That is the ordinary path - pulling :latest repeatedly as the version
    # advances - so the cleanup was blind to exactly the images it accumulates.
    # The tester measured 11 of them, 1.73 GB each, while every pull reported
    # "No superseded UIS images to remove" (2026-08-26).
    #
    # It passed its own round because that falsification pulled a DIGEST, which
    # leaves the image as repo:<none> - still inside the old filter. The
    # reachable state was tested; the state that actually accumulates was not.
    #
    # So: by repository name, AND by our source label which survives the loss of
    # the name. The union also covers images built before the label existed,
    # which the label filter alone would miss.
    local all_ids
    all_ids="$( {
        docker images "$repo" --format '{{.ID}}' --no-trunc 2>/dev/null || true
        docker images -a --no-trunc --filter "label=org.opencontainers.image.source=$UIS_IMAGE_SOURCE" \
            --format '{{.ID}}' 2>/dev/null || true
    } | sort -u )"
    [ -n "$all_ids" ] || return 0

    local id size blocked=0 blockers=""
    for id in $all_ids; do
        case " $keep_ids " in *" $id "*) continue ;; esac

        size="$(docker image inspect "$id" --format '{{.Size}}' 2>/dev/null || echo 0)"
        # No -f: an image still referenced by ANY container stays, by design.
        if docker rmi "$id" >/dev/null 2>&1; then
            freed=$(( freed + size ))
            removed=$(( removed + 1 ))
        else
            # ⚠️ "could not remove" and "nothing to remove" are DIFFERENT, and
            # the first version of this reported them identically — it said
            # "No superseded UIS images to remove" while 1.18 GB sat there,
            # held by a stopped container. Same defect this codebase has been
            # chasing all week, written into the fix for it.
            blocked=$(( blocked + 1 ))
            local holder
            holder="$(docker ps -a --filter "ancestor=$id" --format '{{.Names}} ({{.Status}})' 2>/dev/null | head -3 | tr '\n' ' ')"
            blockers="$blockers  ${id#sha256:} <- ${holder:-unknown container}\n"
        fi
    done

    if [ "$removed" -gt 0 ]; then
        log_info "Removed $removed superseded UIS image(s), freeing $(( freed / 1024 / 1024 )) MB"
    fi

    if [ "$blocked" -gt 0 ]; then
        log_info "$blocked superseded UIS image(s) could NOT be removed - a container still references them:"
        printf "%b" "$blockers" >&2
        log_info "These are usually leftover stopped containers. To reclaim the space:"
        log_info "    docker ps -a --filter ancestor=<image-id>     # see what holds it"
        log_info "    docker rm <container>  &&  ./uis pull         # then this will clear it"
        log_info "Not forced on purpose: -f would delete an image another container is using."
    fi

    if [ "$removed" -eq 0 ] && [ "$blocked" -eq 0 ]; then
        log_info "No superseded UIS images to remove"
    fi
}

# ─── Version detection, adopted from devcontainer-toolbox ────────────────────
#
# UIS is delivered as TWO artefacts — this launcher on the host, and the
# container image — and until now only the image carried a version. So a box
# running a three-week-old launcher against today's image reported v0.1.1 and
# looked current, which is how three defects stayed invisible in two days: the
# kubeconfig written as a symlink, images never cleaned up, and an override the
# launcher dropped.
#
# ⚠️ ONE VERSION FILE, deliberately: version.txt at the repository root. The
# launcher does NOT carry a version of its own. That is the DCT model, and the
# reason it works: the product has one version, and updating refreshes the
# host-side file too, so "are they in step?" is answered by "did you update?"
# rather than by comparing two numbers that can drift apart.
# Overridable so the falsification recipes in the dispatches can actually point
# this somewhere else. It was hard-assigned for three rounds, which made my own
# "point it at a wrong URL" test inert and forced the tester to patch the
# launcher by hand each time to run it.
UIS_RAW_BASE="${UIS_RAW_BASE:-https://raw.githubusercontent.com/helpers-no/urbalurba-infrastructure/main}"

# Used to recognise our images even after they lose their repository name.
UIS_IMAGE_SOURCE="${UIS_IMAGE_SOURCE:-https://github.com/helpers-no/urbalurba-infrastructure}"

# The version this machine is running: read from the image, which is the
# artefact that carries it.
installed_version() {
    docker exec "$CONTAINER_NAME" cat /mnt/urbalurbadisk/version.txt 2>/dev/null | tr -d "[:space:]" \
        || docker run --rm --entrypoint cat "$IMAGE" /mnt/urbalurbadisk/version.txt 2>/dev/null | tr -d "[:space:]" \
        || echo ""
}

# The version published upstream.
#
# ⚠️ raw.githubusercontent.com is CDN-CACHED. Measured on 2026-08-25: it served
# the previous version for about four minutes after the merge landed, while the
# GitHub API already returned the new one. So immediately after a release this
# will report "up to date" against a version that has just been superseded.
#
# That is not worth engineering around - a few minutes' lag on a version check
# costs nothing - but it IS worth knowing, because the alternative is someone
# debugging a correct check for an hour. If you need the authoritative answer
# right now:
#     gh api repos/helpers-no/urbalurba-infrastructure/contents/version.txt?ref=main -q .content | base64 -d
remote_version() {
    curl -fsSL --max-time 10 "$UIS_RAW_BASE/version.txt" 2>/dev/null | tr -d "[:space:]" || echo ""
}

# ─── Ambient update notice ───────────────────────────────────────────────────
#
# Adopted from DCT, where the check is ambient rather than something the user
# remembers to run: dev-welcome shows it on every shell start, so drift is
# noticed without anyone going looking.
#
# Two adaptations, both because UIS is shaped differently:
#
#   1. DCT checks once per container start - a shell session. Every `./uis` is
#      a fresh process, so the equivalent is per-invocation. Without a cache
#      that is a network call for every `./uis list`, so the answer is cached
#      briefly on disk.
#
#   2. DCT uses --connect-timeout 2 so the check can never block the user. That
#      part is copied exactly, and it matters more here: `./uis deploy` on a
#      disconnected laptop must not wait on GitHub.
#
# Silent when up to date. The notice IS the signal - a line printed every time
# would be ignored within a day, which is how the drift went unnoticed in the
# first place.
UIS_VERSION_CACHE="${UIS_VERSION_CACHE:-$SCRIPT_DIR/.uis.version-check}"
UIS_VERSION_CACHE_TTL="${UIS_VERSION_CACHE_TTL:-3600}"

# Echo the latest version, using a cached answer when it is fresh enough.
# Never blocks for more than a couple of seconds, and never fails the command.
cached_remote_version() {
    local now cached_at
    now="$(date +%s)"

    if [ -f "$UIS_VERSION_CACHE" ]; then
        cached_at="$(head -1 "$UIS_VERSION_CACHE" 2>/dev/null || echo 0)"
        case "$cached_at" in ''|*[!0-9]*) cached_at=0 ;; esac
        if [ $(( now - cached_at )) -lt "$UIS_VERSION_CACHE_TTL" ]; then
            tail -1 "$UIS_VERSION_CACHE" 2>/dev/null
            return 0
        fi
    fi

    local remote
    remote="$(curl -fsSL --connect-timeout 2 --max-time 4 "$UIS_RAW_BASE/version.txt" 2>/dev/null | tr -d "[:space:]" || echo "")"

    # Only cache a real answer. Caching an empty result would suppress the
    # notice for an hour every time the user happened to be offline once.
    if [ -n "$remote" ]; then
        printf '%s\n%s\n' "$now" "$remote" > "$UIS_VERSION_CACHE" 2>/dev/null || true
    fi
    echo "$remote"
}

# One line, only when there is something to say.
maybe_notify_update() {
    [ -n "${UIS_NO_VERSION_CHECK:-}" ] && return 0
    # Not on a terminal - a script parsing our output should not get this.
    [ -t 2 ] || return 0

    local installed remote
    installed="$(installed_version)"
    [ -n "$installed" ] || return 0

    remote="$(cached_remote_version)"
    [ -n "$remote" ] || return 0
    [ "$installed" = "$remote" ] && return 0

    log_info "Update available: $installed -> $remote   (run: ./uis pull)"
}

# Show the version, always; the update line only when there is one.
#
# DCT's shape: one function, two formats, called from the places a user looks -
# the welcome line and `dev-help`. One function so the formats cannot drift
# apart, and the version shown unconditionally while the update notice is the
# exception. A banner that always says something is one people stop reading.
#
#   short : one line, for headers
#   full  : the version, then an indented update line if behind
show_version_info() {
    local format="${1:-full}"
    local installed remote update=""
    installed="$(installed_version)"
    [ -n "$installed" ] || installed="unknown"
    remote="$(cached_remote_version)"

    if [ -n "$remote" ] && [ "$installed" != "unknown" ] && [ "$installed" != "$remote" ]; then
        update="$remote"
    fi

    if [ "$format" = "short" ]; then
        if [ -n "$update" ]; then
            echo "UIS v$installed - Update available: v$update (run: ./uis pull)"
        else
            echo "UIS v$installed"
        fi
    else
        echo "UIS (Urbalurba Infrastructure Stack) v$installed"
        [ -n "$update" ] && echo "  Update available: v$update   (run: ./uis pull)"
    fi
}

# Report where this machine stands. Used by `./uis version` and `./uis pull`.
# Returns 0 if up to date, 1 if an update is available, 2 if it could not tell.
report_version_status() {
    local installed remote
    installed="$(installed_version)"
    remote="$(remote_version)"

    if [ -z "$installed" ]; then
        log_info "Installed version: unknown (no image on this machine yet)"
    else
        log_info "Installed version: $installed"
    fi

    if [ -z "$remote" ]; then
        # ⚠️ Could-not-check is NOT up-to-date. Reporting them the same way is
        # the defect this project has spent a week removing from its own
        # playbooks; it is not going into the launcher.
        log_info "Latest version:    could not be determined (offline, or GitHub unreachable)"
        return 2
    fi

    log_info "Latest version:    $remote"

    if [ -z "$installed" ]; then
        return 1
    elif [ "$installed" = "$remote" ]; then
        log_info "Up to date."
        return 0
    else
        log_info "Update available: $installed -> $remote   (run: ./uis pull)"
        return 1
    fi
}

# Refresh the launcher itself. This is the step UIS was missing entirely: the
# image can be updated by `docker pull`, but nothing ever updated this file, so
# fixes shipped to it never reached the machines running it.
update_launcher() {
    # Which file to replace. ${BASH_SOURCE[0]} is the file this function is
    # DEFINED in - correct today, because that is this launcher, but it would
    # silently overwrite a library if the function ever moved. Naming it
    # explicitly makes the target unambiguous and lets it be tested against a
    # throwaway file instead of the real launcher.
    local target="${UIS_LAUNCHER_PATH:-${BASH_SOURCE[0]}}"

    # ⚠️ Absolute, because $backup is derived from $target and the restore
    # instruction we print is only useful if it works from anywhere.
    # Invoked as `./uis`, BASH_SOURCE is RELATIVE, so we printed
    #     Restore with: cp "./uis.bak-20260826-002933" "./uis"
    # which silently refers to a different file after a single `cd` - and the
    # moment you need it is the moment the launcher is broken. Found by the
    # independent tester (2026-08-26).
    #
    # `readlink -f`/`realpath` are NOT portable - the tester runs macOS, where
    # BSD readlink has no -f. `cd $(dirname) && pwd -P` is POSIX and works on
    # both. The basename is deliberately NOT resolved: if the launcher itself
    # is a symlink we replace the symlink, which is the existing behaviour.
    local _ldir
    if _ldir="$(cd "$(dirname "$target")" 2>/dev/null && pwd -P)" && [ -n "$_ldir" ]; then
        target="$_ldir/$(basename "$target")"
    fi

    [ -w "$target" ] || { log_info "Launcher not writable, skipping self-update: $target"; return 0; }

    # ⚠️ The temp file MUST live beside the target, not in /tmp.
    #
    # `mv` is atomic only within one filesystem. On a Raspberry Pi /tmp is
    # tmpfs while ~/uis is the SD card - different filesystems - so mv silently
    # degrades to copy-then-unlink. A crash, a full disk or a killed process
    # mid-copy would leave a TRUNCATED launcher on the machine that manages the
    # platform, with no way to run the command that fixes it.
    #
    # Created in the target's directory, the replace is a rename within one
    # filesystem: it either happened or it did not.
    local tmp
    tmp="$(mktemp "${target}.new.XXXXXX")" || {
        log_info "Could not create a temp file beside the launcher - skipping self-update"
        return 0
    }

    if ! curl -fsSL --max-time 20 "$UIS_RAW_BASE/uis" -o "$tmp" 2>/dev/null; then
        log_info "Could not fetch the latest launcher - keeping the current one"
        rm -f "$tmp"; return 0
    fi

    # ⚠️ A TRUNCATED DOWNLOAD CAN STILL BE VALID BASH.
    #
    # `bash -n` alone is not enough: a file cut off at a statement boundary
    # parses cleanly and would be installed, leaving a launcher missing half its
    # commands. So check it looks like OUR launcher and is a plausible size
    # before trusting the syntax check.
    local size
    size="$(wc -c < "$tmp" 2>/dev/null || echo 0)"
    if [ "$size" -lt 8000 ]; then
        log_error "Downloaded launcher is only ${size} bytes - refusing to install a truncated file"
        rm -f "$tmp"; return 1
    fi
    if ! grep -q "^start_container()" "$tmp" || ! grep -q "^case \"\${1:-help}\" in" "$tmp"; then
        log_error "Downloaded file does not look like the UIS launcher - NOT installing it"
        rm -f "$tmp"; return 1
    fi

    # Never install something that will not parse. A launcher that fails to
    # source leaves the machine with no way to run the command that fixes it.
    if ! bash -n "$tmp" 2>/dev/null; then
        log_error "Downloaded launcher failed a syntax check - NOT installing it"
        rm -f "$tmp"; return 1
    fi

    if cmp -s "$tmp" "$target"; then
        rm -f "$tmp"; return 0
    fi

    local backup="${target}.bak-$(date +%Y%m%d-%H%M%S)"
    cp "$target" "$backup" || { rm -f "$tmp"; return 1; }

    # ⚠️ mv, not an in-place edit. This script is EXECUTING. mv writes a new
    # inode, so the running shell keeps its descriptor on the old file and
    # finishes cleanly; editing in place would corrupt it mid-read.
    if mv "$tmp" "$target" && chmod +x "$target"; then
        log_info "Launcher updated. Previous version saved at:"
        log_info "    $backup"
        log_info "    Restore with: cp \"$backup\" \"$target\""
        log_info "The new launcher applies to your NEXT ./uis command."
    else
        log_error "Could not replace the launcher; it is unchanged (backup: $backup)"
        rm -f "$tmp"; return 1
    fi
}

pull_container() {
    # ⚠️ `|| true` IS LOAD-BEARING. This script runs under `set -e`, and
    # report_version_status deliberately returns 1 when an update is available
    # and 2 when the remote cannot be reached. Called bare, either return
    # ABORTED THE SCRIPT HERE - so `./uis pull` did nothing whenever there was
    # something to do, and worked only when there was not. Found by the
    # independent tester (2026-08-26).
    #
    # A non-zero return that MEANS something must never be left bare under
    # set -e. See the other three call sites below.
    report_version_status || true
    log_info "Pulling latest UIS container image..."
    if docker pull "$IMAGE"; then
        log_info "Image updated successfully"
        if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
            log_info "Restarting container with new image..."
            stop_container
            start_container
            log_info "Container restarted with new image"
        else
            log_info "Container is not running. Start it with: ./uis start"
        fi
        # After the restart, so the container is already on the new image and
        # the old one is genuinely unreferenced.
        cleanup_old_images
        # Same hazard: update_launcher returns 1 when it REFUSES a download
        # (truncated, wrong file, bad syntax). That is a correct refusal, not a
        # reason to abort the rest of the command.
        update_launcher || true
        log_info "Now running version: $(installed_version)"
    else
        log_error "Failed to pull image"
        exit 1
    fi
}

# Stop container
stop_container() {
    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        log_info "Stopping UIS container..."
        docker stop "$CONTAINER_NAME" >/dev/null
        log_info "Container stopped"
    else
        log_warn "Container is not running"
    fi
}

# Show usage
show_usage() {
    echo "UIS - Urbalurba Infrastructure Stack"
    echo ""
    echo "Usage: ./uis <command> [args]"
    echo ""
    echo "Commands:"
    echo "  start       Start the UIS container"
    echo "  stop        Stop the UIS container"
    echo "  restart     Restart the UIS container"
    echo "  status      Show container status"
    echo "  shell       Open a shell in the container"
    echo "  exec <cmd>  Execute a command in the container"
    echo "  logs        Show container logs"
    echo "  build       Build the container image locally"
    echo "  test        Run container validation tests (CI/CD)"
    echo "  help        Show this help message"
    echo ""
    echo "Examples:"
    echo "  ./uis start                    # Start the container"
    echo "  ./uis shell                    # Enter the container"
    echo "  ./uis exec kubectl get pods    # Run kubectl command"
    echo ""
    echo "Environment variables:"
    echo "  UIS_IMAGE          Override the container image (default: ghcr.io/helpers-no/uis-provision-host:latest)"
    echo "  UIS_KUBECONFIG_DIR Override kubeconfig directory (default: \$HOME/.kube)"
}

# Main command handler
# ⚠️ Before the dispatch, so EVERY command carries it - which is the point. The
# user should not have to remember to check; that is how three-week-old
# launchers went unnoticed on three machines at once. Silent unless there is an
# update, capped at a few seconds, cached for an hour, and skipped for `version`
# and `pull` because those report the versions themselves.
case "${1:-help}" in
    # `help` is NOT excluded: the container's own help prints the version
    # header, so all it needs from us is the update line. Adding
    # show_version_info here printed the version twice.
    version|--version|-v|pull|container) : ;;
    *) maybe_notify_update ;;
esac

case "${1:-help}" in
    start)
        start_container
        log_info "UIS container is ready"
        ;;
    stop)
        stop_container
        ;;
    restart)
        stop_container
        start_container
        log_info "UIS container restarted"
        ;;
    container)
        show_version_info short
        if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
            log_info "Container is running"
            docker ps --filter "name=$CONTAINER_NAME" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
        else
            log_warn "Container is not running"
        fi
        ;;
    shell)
        start_container
        docker exec $DOCKER_IT "${ENV_ARGS[@]}" "$CONTAINER_NAME" bash
        ;;
    exec)
        shift
        if [ $# -eq 0 ]; then
            log_error "No command specified"
            exit 1
        fi
        start_container
        docker exec $DOCKER_IT "${ENV_ARGS[@]}" "$CONTAINER_NAME" "$@"
        ;;
    logs)
        docker logs "$CONTAINER_NAME" ${2:---tail 50}
        ;;
    pull)
        # --check: report drift without installing anything. DCT has this and it
        # is the difference between "tell me" and "change my machine".
        if [ "${2:-}" = "--check" ]; then
            vstatus=0
            report_version_status || vstatus=$?
            exit "$vstatus"
        fi
        pull_container
        ;;
    version|--version|-v)
        # ⚠️ Reports BOTH halves. This used to fall through to the container's
        # own `uis-cli.sh version`, so a machine running a three-week-old
        # launcher printed the image's version and looked current. That is
        # exactly how the launcher drift stayed invisible.
        vstatus=0
        report_version_status || vstatus=$?
        if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
            docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh version 2>/dev/null || true
        fi
        exit "$vstatus"
        ;;
    build)
        log_info "Building UIS container image..."
        docker build -f "$SCRIPT_DIR/Dockerfile.uis-provision-host" -t uis-provision-host:local "$SCRIPT_DIR"
        log_info "Build complete"
        ;;
    test)
        # CI/CD test command - validates container without requiring kubernetes
        log_info "Running UIS container validation tests..."
        start_container

        # Clean up old temp directories
        docker exec "$CONTAINER_NAME" rm -rf /mnt/urbalurbadisk/.temp /mnt/urbalurbadisk/generate 2>/dev/null || true

        # Test 0: deploy-flow binaries are present
        # Catches silent regressions in the provision-host-02-kubetools.sh layer
        # (e.g. a curl from dl.k8s.io failing without aborting the build, leaving
        # an empty /usr/local/bin/kubectl). Without this, missing binaries only
        # surface when an actual ./uis deploy runs against a cluster.
        log_info "Test 0: deploy-flow binary presence"
        docker exec "$CONTAINER_NAME" bash -c '
          set -e
          for bin in kubectl helm ansible-playbook python3; do
            if ! command -v "$bin" >/dev/null 2>&1; then
              echo "MISSING: $bin not found on PATH" >&2
              exit 1
            fi
            echo "  $bin: $(command -v "$bin")"
          done
          # bcrypt is needed by 090-setup-gravitee.yml for admin-password wiring
          python3 -c "import bcrypt" || { echo "MISSING: python3 bcrypt module" >&2; exit 1; }
          echo "  python3 bcrypt: ok"
        '

        # Test 1: uis-cli version
        log_info "Test 1: uis-cli version"
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh version

        # Test 2: uis-cli list
        log_info "Test 2: uis-cli list"
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh list

        # Test 3: uis-cli stack list
        log_info "Test 3: uis-cli stack list"
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh stack list

        # Test 4: JSON generation
        log_info "Test 4: JSON generation"
        docker exec "$CONTAINER_NAME" bash -c "cd /mnt/urbalurbadisk && ./provision-host/uis/manage/uis-docs.sh"

        # Test 5: Schema validation
        log_info "Test 5: Schema validation"
        docker exec "$CONTAINER_NAME" bash -c "cd /mnt/urbalurbadisk && ./provision-host/uis/tests/validate-schemas.sh"

        # Test 6: Enable/disable cycle
        log_info "Test 6: Enable/disable service"
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh enable prometheus
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh list-enabled
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh disable prometheus

        log_info "All tests passed!"
        ;;
    help|--help|-h)
        start_container
        docker exec $DOCKER_IT "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh help
        echo ""
        echo "Container management:"
        echo "  start       Start the UIS container"
        echo "  stop        Stop the UIS container"
        echo "  restart     Restart the UIS container"
        echo "  container   Show container status"
        echo "  shell       Open a shell in the container"
        echo "  logs        Show container logs"
        echo "  pull        Pull latest container image and restart"
        echo "  build       Build the container image locally"
        echo "  test        Run container validation tests"
        ;;
    *)
        # Pass all other commands to uis-cli.sh inside the container
        start_container
        docker exec $DOCKER_IT "${ENV_ARGS[@]}" "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh "$@"
        ;;
esac
