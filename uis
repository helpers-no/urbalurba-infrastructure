#!/bin/bash
# UIS - Urbalurba Infrastructure Stack CLI wrapper
# This script manages the UIS provision-host container
#
# Usage: ./uis <command> [args]
# Run ./uis help for available commands

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTAINER_NAME="uis-provision-host"
IMAGE="${UIS_IMAGE:-ghcr.io/helpers-no/uis-provision-host:latest}"
KUBECONFIG_DIR="${UIS_KUBECONFIG_DIR:-$HOME/.kube}"

# ---------------------------------------------------------------------------
# Environment forwarded into the container
#
# ⚠️ `docker exec` does NOT inherit the caller's environment. A variable set on
# the host simply does not exist inside, silently — so any documented override
# that is not listed here is a NO-OP that looks like it worked.
#
# That happened: the dispatch for a test told the tester to run
#   PG_PSQL_HOST=10.255.255.1 ./uis configure postgrest ...
# and every psql call went to the default anyway. The run SUCCEEDED, which
# reads as "the tool handled a dead host fine" rather than "the override never
# arrived". A test whose failure mode is indistinguishable from success is not
# a test.
#
# Add a variable here when the code inside the container reads it and an
# operator is meant to be able to set it. Keep it an allow-list rather than
# forwarding the whole environment: the container should not inherit whatever
# happens to be exported on someone's laptop.
UIS_FORWARDED_ENV=(
    PG_PSQL_HOST            # lib/pg-connection.sh — how UIS reaches postgres
    UIS_VERIFY_KUBECONFIG   # lib/verify-target.sh — which kubeconfig verifies read
    UIS_TARGET_HOST         # which cluster `./uis verify` asks. VERIFY ONLY —
                            # deploy/undeploy act on the ACTIVE kubectl context
                            # and refuse if this disagrees with it.
)

# TARGET_HOST is the name an operator naturally reaches for, but the container's
# cluster-config.sh assigns TARGET_HOST unconditionally and would overwrite it.
# Accept the friendly name here and forward it under the one the container
# honours. Setting UIS_TARGET_HOST directly also works.
if [ -n "${TARGET_HOST+x}" ] && [ -z "${UIS_TARGET_HOST+x}" ]; then
    UIS_TARGET_HOST="$TARGET_HOST"
fi

# Build the `-e NAME=value` arguments for those that are actually set, so an
# unset variable stays unset inside rather than becoming an empty string.
build_env_args() {
    ENV_ARGS=()
    local name
    for name in "${UIS_FORWARDED_ENV[@]}"; do
        if [ -n "${!name+x}" ]; then
            ENV_ARGS+=(-e "$name=${!name}")
        fi
    done
}
build_env_args

# Detect TTY for docker exec flags
# -it for interactive terminal, -i only for piped stdin (still forwards input)
if [ -t 0 ] && [ -t 1 ]; then
    DOCKER_IT="-it"
else
    DOCKER_IT="-i"
fi

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[UIS]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[UIS]${NC} $1"; }
log_error() { echo -e "${RED}[UIS]${NC} $1"; }

# Check if image exists, pull if needed
check_image() {
    if docker image inspect "$IMAGE" &>/dev/null; then
        return 0
    fi

    # Image not found locally - try to pull if it looks like a registry image
    if [[ "$IMAGE" == *"/"* ]]; then
        log_info "Image '$IMAGE' not found locally, pulling from registry..."
        if docker pull "$IMAGE"; then
            log_info "Image pulled successfully"
            return 0
        fi
        log_error "Failed to pull image '$IMAGE'"
    else
        log_error "Image '$IMAGE' not found!"
    fi

    log_info "Build it with: docker build -f Dockerfile.uis-provision-host -t uis-provision-host:local ."
    log_info "Or pull from registry: export UIS_IMAGE=ghcr.io/helpers-no/uis-provision-host:latest"
    exit 1
}

# Create config directories on first run
init_config_dirs() {
    local first_run=false

    # Create .uis.extend if it doesn't exist
    if [ ! -d "$SCRIPT_DIR/.uis.extend" ]; then
        log_info "Creating .uis.extend/ configuration directory..." >&2
        mkdir -p "$SCRIPT_DIR/.uis.extend"
        first_run=true
    fi

    # Create .uis.secrets if it doesn't exist
    if [ ! -d "$SCRIPT_DIR/.uis.secrets" ]; then
        log_info "Creating .uis.secrets/ directory..." >&2
        mkdir -p "$SCRIPT_DIR/.uis.secrets"
        first_run=true
    fi

    # Ensure .uis.secrets is in .gitignore (create file if needed)
    if [ ! -f "$SCRIPT_DIR/.gitignore" ]; then
        # Create .gitignore with .uis.secrets entry
        echo "# UIS secrets - do not commit" > "$SCRIPT_DIR/.gitignore"
        echo ".uis.secrets/" >> "$SCRIPT_DIR/.gitignore"
        log_info "Created .gitignore with .uis.secrets/" >&2
    elif ! grep -q "^\.uis\.secrets" "$SCRIPT_DIR/.gitignore" 2>/dev/null; then
        # Append to existing .gitignore
        echo "" >> "$SCRIPT_DIR/.gitignore"
        echo "# UIS secrets (auto-added)" >> "$SCRIPT_DIR/.gitignore"
        echo ".uis.secrets/" >> "$SCRIPT_DIR/.gitignore"
        log_info "Added .uis.secrets/ to .gitignore" >&2
    fi

    # Return first_run status for welcome message (shown after container starts)
    echo "$first_run"
}

# Show welcome message from inside container
show_welcome() {
    docker exec "$CONTAINER_NAME" bash -c '
        if [ -f /mnt/urbalurbadisk/provision-host/uis/templates/welcome.txt ]; then
            cat /mnt/urbalurbadisk/provision-host/uis/templates/welcome.txt
        fi
    ' 2>/dev/null || true
}

# Start container if not running
start_container() {
    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        return 0
    fi

    check_image
    local first_run
    first_run=$(init_config_dirs)

    log_info "Starting UIS container..."

    # Remove old container if exists
    docker rm -f "$CONTAINER_NAME" 2>/dev/null || true

    # Build volume mount arguments
    local VOLUME_ARGS=(
        -v "$SCRIPT_DIR/.uis.extend:/mnt/urbalurbadisk/.uis.extend"
        -v "$SCRIPT_DIR/.uis.secrets:/mnt/urbalurbadisk/.uis.secrets"
    )

    # Add kubeconfig mount if it exists
    # On WSL, ~/.kube/config is often a symlink to a Windows path - Docker cannot
    # follow the symlink inside the container, so we resolve it and mount the file directly.
    # On Linux/Mac where config is a real file, behavior is unchanged.
    if [ -d "$KUBECONFIG_DIR" ]; then
        local kubeconfig_file="$KUBECONFIG_DIR/config"
        if [ -L "$kubeconfig_file" ]; then
            local resolved
            resolved="$(readlink -f "$kubeconfig_file" 2>/dev/null)"
            if [ -f "$resolved" ]; then
                log_info "Resolved kubeconfig symlink to: $resolved"
                VOLUME_ARGS+=(-v "$resolved:/home/ansible/.kube/config:ro")
            else
                VOLUME_ARGS+=(-v "$KUBECONFIG_DIR:/home/ansible/.kube:ro")
            fi
        else
            VOLUME_ARGS+=(-v "$KUBECONFIG_DIR:/home/ansible/.kube:ro")
        fi
    else
        log_warn "Kubeconfig directory not found: $KUBECONFIG_DIR"
        log_warn "Kubernetes commands will not work until kubeconfig is configured"
    fi

    # Start with host network (so 127.0.0.1 in kubeconfig works)
    # This matches how the original provision-host container was configured
    docker run -d --name "$CONTAINER_NAME" \
        --network host \
        --privileged \
        "${VOLUME_ARGS[@]}" \
        "$IMAGE"

    # Wait for container to be ready
    sleep 2

    # Put the host kubeconfig where the ~100 ansible playbooks read it.
    #
    # ⚠️ A REAL FILE, NOT A SYMLINK — and this line is why.
    #
    # This used to be `ln -sf /home/ansible/.kube/config <path>`. That symlink
    # points into the container's own home, which cannot be read back through
    # the bind mount: kubectl reports "operation not permitted". Every ansible
    # playbook reads that path, so EVERY verify failed — and failed by blaming
    # the service it was verifying, not the config.
    #
    # It ran on every `./uis start`, so restarting the container did not repair
    # the state, it RE-CREATED it. Container-side code that fixed the path was
    # undone by the next start. Found by the independent tester (2026-08-25),
    # who was following remediation advice that told them to restart.
    #
    # Errors are reported rather than swallowed: a silent failure here breaks
    # everything downstream and points nowhere.
    docker exec "$CONTAINER_NAME" bash -c '
        set -e
        KC_DIR=/mnt/urbalurbadisk/.uis.secrets/generated/kubeconfig
        KC="$KC_DIR/kubeconf-all"
        [ -d /mnt/urbalurbadisk/.uis.secrets ] || exit 0
        mkdir -p "$KC_DIR"
        if [ -f /home/ansible/.kube/config ]; then
            # --remove-destination replaces a symlink left by an older launcher
            # instead of following it into the unwritable target.
            cp --remove-destination /home/ansible/.kube/config "$KC" || exit 1
            chmod 600 "$KC" || true
        fi
        # Assert the outcome, not the command.
        if [ -L "$KC" ] || [ ! -r "$KC" ]; then
            echo "WARNING: $KC is not a readable regular file." >&2
            echo "         Ansible playbooks read it; kubectl will fail for all of them." >&2
            exit 1
        fi
    ' || log_info "WARNING: could not write the merged kubeconfig; verifies may fail"

    log_info "Container started"

    # Initialize config files on first run
    if [ "$first_run" = "true" ]; then
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh init 2>/dev/null || true
        show_welcome
    fi
}

# Pull latest container image and restart
pull_container() {
    log_info "Pulling latest UIS container image..."
    if docker pull "$IMAGE"; then
        log_info "Image updated successfully"
        if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
            log_info "Restarting container with new image..."
            stop_container
            start_container
            log_info "Container restarted with new image"
        else
            log_info "Container is not running. Start it with: ./uis start"
        fi
    else
        log_error "Failed to pull image"
        exit 1
    fi
}

# Stop container
stop_container() {
    if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        log_info "Stopping UIS container..."
        docker stop "$CONTAINER_NAME" >/dev/null
        log_info "Container stopped"
    else
        log_warn "Container is not running"
    fi
}

# Show usage
show_usage() {
    echo "UIS - Urbalurba Infrastructure Stack"
    echo ""
    echo "Usage: ./uis <command> [args]"
    echo ""
    echo "Commands:"
    echo "  start       Start the UIS container"
    echo "  stop        Stop the UIS container"
    echo "  restart     Restart the UIS container"
    echo "  status      Show container status"
    echo "  shell       Open a shell in the container"
    echo "  exec <cmd>  Execute a command in the container"
    echo "  logs        Show container logs"
    echo "  build       Build the container image locally"
    echo "  test        Run container validation tests (CI/CD)"
    echo "  help        Show this help message"
    echo ""
    echo "Examples:"
    echo "  ./uis start                    # Start the container"
    echo "  ./uis shell                    # Enter the container"
    echo "  ./uis exec kubectl get pods    # Run kubectl command"
    echo ""
    echo "Environment variables:"
    echo "  UIS_IMAGE          Override the container image (default: ghcr.io/helpers-no/uis-provision-host:latest)"
    echo "  UIS_KUBECONFIG_DIR Override kubeconfig directory (default: \$HOME/.kube)"
}

# Main command handler
case "${1:-help}" in
    start)
        start_container
        log_info "UIS container is ready"
        ;;
    stop)
        stop_container
        ;;
    restart)
        stop_container
        start_container
        log_info "UIS container restarted"
        ;;
    container)
        if docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
            log_info "Container is running"
            docker ps --filter "name=$CONTAINER_NAME" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"
        else
            log_warn "Container is not running"
        fi
        ;;
    shell)
        start_container
        docker exec $DOCKER_IT "${ENV_ARGS[@]}" "$CONTAINER_NAME" bash
        ;;
    exec)
        shift
        if [ $# -eq 0 ]; then
            log_error "No command specified"
            exit 1
        fi
        start_container
        docker exec $DOCKER_IT "${ENV_ARGS[@]}" "$CONTAINER_NAME" "$@"
        ;;
    logs)
        docker logs "$CONTAINER_NAME" ${2:---tail 50}
        ;;
    pull)
        pull_container
        ;;
    build)
        log_info "Building UIS container image..."
        docker build -f "$SCRIPT_DIR/Dockerfile.uis-provision-host" -t uis-provision-host:local "$SCRIPT_DIR"
        log_info "Build complete"
        ;;
    test)
        # CI/CD test command - validates container without requiring kubernetes
        log_info "Running UIS container validation tests..."
        start_container

        # Clean up old temp directories
        docker exec "$CONTAINER_NAME" rm -rf /mnt/urbalurbadisk/.temp /mnt/urbalurbadisk/generate 2>/dev/null || true

        # Test 0: deploy-flow binaries are present
        # Catches silent regressions in the provision-host-02-kubetools.sh layer
        # (e.g. a curl from dl.k8s.io failing without aborting the build, leaving
        # an empty /usr/local/bin/kubectl). Without this, missing binaries only
        # surface when an actual ./uis deploy runs against a cluster.
        log_info "Test 0: deploy-flow binary presence"
        docker exec "$CONTAINER_NAME" bash -c '
          set -e
          for bin in kubectl helm ansible-playbook python3; do
            if ! command -v "$bin" >/dev/null 2>&1; then
              echo "MISSING: $bin not found on PATH" >&2
              exit 1
            fi
            echo "  $bin: $(command -v "$bin")"
          done
          # bcrypt is needed by 090-setup-gravitee.yml for admin-password wiring
          python3 -c "import bcrypt" || { echo "MISSING: python3 bcrypt module" >&2; exit 1; }
          echo "  python3 bcrypt: ok"
        '

        # Test 1: uis-cli version
        log_info "Test 1: uis-cli version"
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh version

        # Test 2: uis-cli list
        log_info "Test 2: uis-cli list"
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh list

        # Test 3: uis-cli stack list
        log_info "Test 3: uis-cli stack list"
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh stack list

        # Test 4: JSON generation
        log_info "Test 4: JSON generation"
        docker exec "$CONTAINER_NAME" bash -c "cd /mnt/urbalurbadisk && ./provision-host/uis/manage/uis-docs.sh"

        # Test 5: Schema validation
        log_info "Test 5: Schema validation"
        docker exec "$CONTAINER_NAME" bash -c "cd /mnt/urbalurbadisk && ./provision-host/uis/tests/validate-schemas.sh"

        # Test 6: Enable/disable cycle
        log_info "Test 6: Enable/disable service"
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh enable prometheus
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh list-enabled
        docker exec "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh disable prometheus

        log_info "All tests passed!"
        ;;
    help|--help|-h)
        start_container
        docker exec $DOCKER_IT "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh help
        echo ""
        echo "Container management:"
        echo "  start       Start the UIS container"
        echo "  stop        Stop the UIS container"
        echo "  restart     Restart the UIS container"
        echo "  container   Show container status"
        echo "  shell       Open a shell in the container"
        echo "  logs        Show container logs"
        echo "  pull        Pull latest container image and restart"
        echo "  build       Build the container image locally"
        echo "  test        Run container validation tests"
        ;;
    *)
        # Pass all other commands to uis-cli.sh inside the container
        start_container
        docker exec $DOCKER_IT "${ENV_ARGS[@]}" "$CONTAINER_NAME" /mnt/urbalurbadisk/provision-host/uis/manage/uis-cli.sh "$@"
        ;;
esac
