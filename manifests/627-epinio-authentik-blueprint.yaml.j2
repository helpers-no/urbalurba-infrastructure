# File: manifests/627-epinio-authentik-blueprint.yaml.j2
#
# Description:
# Authentik-side OAuth2/OIDC Provider + Application for Epinio's Dex connector to
# authenticate against (urb-agents#2040, migrating urb-agents#1909/#1911 gate 18).
# Applied by 627-setup-epinio-identity.yml as a new key inside the existing
# app-slot1-blueprint ConfigMap (manifests/073-authentik-3-app-slot1-blueprint.yaml) -
# Authentik's blueprint controller only discovers files actually volume-mounted into its
# own pods (confirmed live during the PoC: a brand-new ConfigMap, however correctly
# labeled, never appeared in /api/v3/managed/blueprints/ at all), and this expansion slot
# is the documented way to add one without a Helm upgrade or restart.
#
# Reuses "Service Groups Mapping" - the same scope mapping
# manifests/073-authentik-service-protection-blueprint.yaml.j2 already creates for every
# other OAuth2-protected service here - rather than declaring a second, duplicate one.
#
# Template Variables:
# - epinio_identity_authentik: {client_id}
# - epinio_identity_authentik_client_secret

version: 1
metadata:
  name: epinio-oauth2-oidc
entries:
  - model: authentik_providers_oauth2.oauth2provider
    state: present
    identifiers:
      name: epinio-provider
    attrs:
      name: epinio-provider
      client_type: confidential
      client_id: {{ epinio_identity_authentik.client_id }}
      client_secret: {{ epinio_identity_authentik_client_secret }}
      access_code_validity: minutes=1
      access_token_validity: minutes=5
      refresh_token_validity: days=30
      sub_mode: hashed_user_id
      issuer_mode: per_provider
      include_claims_in_id_token: true
      authorization_flow: !Find [authentik_flows.flow, [slug, default-provider-authorization-implicit-consent]]
      invalidation_flow: !Find [authentik_flows.flow, [slug, default-provider-invalidation-flow]]
      signing_key: !Find [authentik_crypto.certificatekeypair, [name, authentik Self-signed Certificate]]
      property_mappings:
        - !Find [authentik_providers_oauth2.scopemapping, [name, "authentik default OAuth Mapping: OpenID 'openid'"]]
        - !Find [authentik_providers_oauth2.scopemapping, [name, "authentik default OAuth Mapping: OpenID 'email'"]]
        - !Find [authentik_providers_oauth2.scopemapping, [name, "authentik default OAuth Mapping: OpenID 'profile'"]]
        - !Find [authentik_providers_oauth2.scopemapping, [name, "Service Groups Mapping"]]
  - model: authentik_core.application
    state: present
    identifiers:
      slug: epinio-app
    attrs:
      name: epinio-app
      slug: epinio-app
      meta_launch_url: ""
      policy_engine_mode: any
      provider: !Find [authentik_providers_oauth2.oauth2provider, [name, epinio-provider]]
