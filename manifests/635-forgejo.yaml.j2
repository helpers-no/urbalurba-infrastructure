# File: manifests/635-forgejo.yaml.j2
#
# Description:
# Forgejo git host + its own built-in OCI registry, as an in-cluster `uis deploy forgejo`
# service — the Rancher Desktop (dev/test) counterpart to the Proxmox LXC guest in
# platforms/proxmox/ansible/roles/forgejo/. Same proven settings (pinned image, app.ini
# content, SQLite, no admin bootstrap), translated from a Docker+systemd guest into
# Kubernetes resources, not independently re-designed — see
# website/docs/ai-developer/plans/backlog/PLAN-system-forgejo-rancher-desktop.md for the
# full translation record and why.
#
# Template Variables (from the setup playbook):
# - forgejo_namespace
# - forgejo_image (pinned by digest, same value as the Proxmox role)
# - forgejo_http_port
# - forgejo_domain (forgejo.localhost)
#
# Secrets (SECRET_KEY/INTERNAL_TOKEN/JWT_SECRET) are a SEPARATE Secret
# (forgejo-app-secrets), generated once by the setup playbook itself and never
# regenerated — see that playbook's own header for why this does NOT go through the
# urbalurba-secrets/00-master-secrets.yml.template pipeline (that pipeline reapplies its
# whole file on every deploy, which would reset these back to empty).
#
# 🔴 FOUND LIVE BY imac (urb-agents#1928), ROUND 1: this image's actual boot path is
# s6-overlay running `su-exec $USER gitea web` with NO flags and NO setup/entrypoint
# script that reads GITEA_APP_INI — that env var is simply never consulted here (true
# for Gitea's Docker image in general; NOT true for this specific rootless Forgejo
# image's s6 run script). The server always reads its config from the hardcoded default
# path, $GITEA_CUSTOM/conf/app.ini = /data/gitea/conf/app.ini — confirmed from the real
# startup log ("ConfigFile: /data/gitea/conf/app.ini").
#
# 🔴 FOUND LIVE BY imac, ROUND 2: a direct ConfigMap subPath mount at that path (this
# file's first fix attempt) crash-loops instead. `gitea web`'s boot sequence
# unconditionally runs an internal `environment-to-ini` step whenever GITEA__-prefixed
# env vars are present (always true here — the three secrets below), and that step
# WRITES the merged config back to the resolved app.ini path before serving:
#   environment-to-ini.go [I] Settings saved to: "/data/gitea/conf/app.ini"
#   environment-to-ini.go [F] ...: open /data/gitea/conf/app.ini: read-only file system
# A ConfigMap-backed mount is read-only at the kernel level regardless of the
# volumeMount's own `readOnly` field — there is no manifest tweak that makes this
# writable. The Proxmox role's own bind-mount never hits this: that's a bare systemd
# unit invoking the forgejo binary directly, no s6, no environment-to-ini step at all.
#
# Fixed by not mounting the ConfigMap at the live path at all — an initContainer `cp`s
# it onto the PVC-backed /data/gitea/conf/app.ini once per pod start, producing a
# normal writable file there (the actual effect the first fix attempt was going for,
# achieved the way Kubernetes requires rather than via a mount flag).

---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: forgejo-data
  namespace: {{ forgejo_namespace }}
  labels:
    app: forgejo
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 10Gi

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: forgejo-app-ini
  namespace: {{ forgejo_namespace }}
  labels:
    app: forgejo
data:
  # Same content as roles/forgejo/templates/app.ini.j2 (the proven Proxmox role), minus
  # the [server] SSH lines — this phase serves HTTP clone/registry only (see the PLAN
  # doc's "What this plan does NOT do" for why SSH is out of scope here, not silently
  # dropped). SECRET_KEY/INTERNAL_TOKEN/JWT_SECRET come from the forgejo-app-secrets
  # Secret via env vars the official image reads directly (GITEA__security__SECRET_KEY
  # etc.) rather than baked into this file — this ConfigMap can be identical across
  # every install, unlike the Proxmox role's app.ini which carries the secrets inline
  # (that role has no equivalent "env var from a Secret" mechanism; a Kubernetes
  # Deployment does, so this uses it instead of duplicating the secret into a ConfigMap).
  app.ini: |
    APP_NAME = Forgejo
    RUN_MODE = prod
    RUN_USER = git

    [server]
    DOMAIN    = {{ forgejo_domain }}
    ROOT_URL  = http://{{ forgejo_domain }}/
    HTTP_PORT = {{ forgejo_http_port }}
    DISABLE_SSH = true

    [database]
    ; sqlite — matches the Proxmox role's own choice (roles/forgejo/templates/app.ini.j2),
    ; not independently decided here. /data is this Deployment's own PVC mount, same
    ; layout the official image expects.
    DB_TYPE = sqlite3
    PATH    = /data/gitea/forgejo.db

    [security]
    ; Disables the interactive web installer — this file IS the install, same as the
    ; Proxmox role. Does not disable Forgejo's own automatic DB migration on startup.
    INSTALL_LOCK = true

    [repository]
    ROOT = /data/git/repositories

    [log]
    MODE  = console
    LEVEL = Info

    [packages]
    ; Forgejo's own built-in OCI registry — what gets pushed to from `uis deploy
    ; forgejo-runner`'s Actions jobs.
    ENABLED = true

---
apiVersion: v1
kind: Service
metadata:
  name: forgejo
  namespace: {{ forgejo_namespace }}
  labels:
    app: forgejo
spec:
  selector:
    app: forgejo
  ports:
    - name: http
      port: {{ forgejo_http_port }}
      targetPort: http

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: forgejo
  namespace: {{ forgejo_namespace }}
  labels:
    app: forgejo
spec:
  replicas: 1
  # SQLite has no concurrent-writer story — same single-instance constraint the Proxmox
  # role carries (one Docker container, one systemd unit). Recreate, not RollingUpdate:
  # two forgejo processes must never point at the same sqlite file at once.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: forgejo
  template:
    metadata:
      labels:
        app: forgejo
    spec:
      securityContext:
        fsGroup: 1000
      initContainers:
        # One-shot per pod start: copy the ConfigMap's app.ini onto the PVC as a real,
        # writable file at the exact path the server's boot sequence reads AND writes
        # back to (environment-to-ini — see the header note above). Re-copies every
        # start, matching the Proxmox role's own "re-applied on every run, not a
        # preserved-forever file" convention for this same file.
        - name: init-config
          image: {{ forgejo_image }}
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -eu
              mkdir -p /data/gitea/conf
              cp /config-source/app.ini /data/gitea/conf/app.ini
              # 0664, not 0644: environment-to-ini (see the header note) writes BACK to
              # this file as the main container's own user, which reaches it only via
              # the Pod's shared fsGroup (1000) supplementary-group membership, not
              # ownership — group-write has to be set explicitly, `cp` alone won't
              # produce it.
              chmod 0664 /data/gitea/conf/app.ini
          volumeMounts:
            - name: data
              mountPath: /data
            - name: app-ini
              mountPath: /config-source
              readOnly: true
      containers:
        - name: forgejo
          image: {{ forgejo_image }}
          ports:
            - name: http
              containerPort: {{ forgejo_http_port }}
          # SECRET-VERSION: none — these three are generated once by the setup
          # playbook and asserted to never regenerate afterward (see
          # 635-setup-forgejo.yml's own header and tasks 4-9). There is no rotation
          # path this annotation would need to propagate.
          env:
            - name: GITEA__security__SECRET_KEY
              valueFrom:
                secretKeyRef:
                  name: forgejo-app-secrets
                  key: SECRET_KEY
            - name: GITEA__security__INTERNAL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: forgejo-app-secrets
                  key: INTERNAL_TOKEN
            - name: GITEA__oauth2__JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: forgejo-app-secrets
                  key: JWT_SECRET
{# urb-agents#2027: plain {% if %}/{% endif %} at column 0, no manual `-` trim markers.
   Ansible's own Jinja environment already runs trim_blocks=True (strips the newline
   right AFTER a tag's %}); adding {%- ALSO strips the newline BEFORE it, and combined
   with a non-zero-indent {% endif %} tag (lstrip_blocks=False, so leading whitespace on
   its line is literal output) that merged this block's surrounding lines into one,
   breaking YAML both with and without this var set. Verified by rendering through
   jinja2.Environment(trim_blocks=True, lstrip_blocks=False) — Ansible's actual
   defaults — not assumed from a plain jinja2.Environment(), which is what missed this
   the first time. #}
{% if forgejo_actions_default_url %}
            # Opt-in only (urb-agents#2025) — empty by default, which leaves Forgejo on
            # its own built-in curated action mirror. See forgejo_actions_default_url's
            # own comment in 635-setup-forgejo.yml for why that's the default, not this.
            - name: GITEA__actions__DEFAULT_ACTIONS_URL
              value: "{{ forgejo_actions_default_url }}"
{% endif %}
          volumeMounts:
            # app.ini is NOT mounted here — the init-config initContainer above
            # already wrote a real, writable copy onto this same PVC at
            # /data/gitea/conf/app.ini before this container starts. Mounting the
            # ConfigMap directly here is exactly what crash-looped (see the header
            # note): it would be read-only at the kernel level no matter what.
            - name: data
              mountPath: /data
          readinessProbe:
            httpGet:
              path: /api/healthz
              port: http
            initialDelaySeconds: 10
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /api/healthz
              port: http
            initialDelaySeconds: 30
            periodSeconds: 15
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: forgejo-data
        - name: app-ini
          configMap:
            name: forgejo-app-ini
