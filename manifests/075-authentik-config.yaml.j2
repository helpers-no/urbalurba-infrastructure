# File: manifests/075-authentik-config.yaml.j2
#
# Description:
# Jinja2 template for Authentik Helm values with dynamic service protection
# Generates CSRF trusted origins and blueprint configuration based on protected services
#
# Template Variables (from kubernetes-secrets.yml):
# - domains: Dictionary of domain configurations
# - protected_services: List of services to protect
# - All existing Authentik configuration variables
#
# Usage:
#   Generated by Ansible from kubernetes-secrets.yml
#   helm upgrade authentik authentik/authentik -n authentik -f 075-authentik-config.yaml

# Authentik Helm Chart Values
# Generated automatically by Auth10 system
authentik:
  # Secret key will be loaded from environment variables
  secret_key: ""  # Empty - loaded via global.env

  # Debugging and error reporting
  error_reporting:
    enabled: false

  # External PostgreSQL configuration
  postgresql:
    host: "postgresql.default.svc.cluster.local"
    name: authentik
    user: authentik
    port: 5432
    password: ""  # Empty - loaded via global.env

  # 🔴 NO redis: BLOCK HERE (urb-agents#2021, part 2) — removed as part of the
  # 2025.8.1 -> 2025.10.3 bump below. Confirmed from 2025.10's own release notes
  # ("fully removing the need for Redis"): caching/outpost/websockets already moved to
  # Postgres before this repo's previous pin, and 2025.10 finishes the job. Not
  # independently confirmed whether supplying this block would still be merely ignored
  # at 2025.10.3 rather than erroring - removed rather than left in place and hoped
  # harmless. The shared `redis` deployment this playbook's own "Check Redis dependency"
  # precondition step still gates on is NOT this: that is a separate, shared UIS service
  # other things may still depend on, deliberately left untouched here.

# CRITICAL: Environment variables for Authentik + outpost communication
global:
  envFrom:
    - secretRef:
        name: urbalurba-secrets
  env:
    # Bootstrap admin account (only used on *first startup*)
    - name: AUTHENTIK_BOOTSTRAP_EMAIL
      valueFrom:
        secretKeyRef:
          name: urbalurba-secrets
          key: AUTHENTIK_BOOTSTRAP_EMAIL
    - name: AUTHENTIK_BOOTSTRAP_PASSWORD
      valueFrom:
        secretKeyRef:
          name: urbalurba-secrets
          key: AUTHENTIK_BOOTSTRAP_PASSWORD
    # AUTHENTIK_HOST: Internal cluster URL for server-to-outpost communication
    - name: AUTHENTIK_HOST
      value: "http://authentik-server.authentik.svc.cluster.local"
    # AUTHENTIK_HOST_BROWSER: URL for browser redirects (uses localhost domain from config)
    # This is required for the embedded outpost to generate correct OAuth redirect URLs
    # Note: This prioritizes localhost development. External domains (tailscale, cloudflare)
    # will redirect to authentik.localhost first, which works for local testing.
    # For production external domains, additional configuration may be needed.
    - name: AUTHENTIK_HOST_BROWSER
      value: "{{ domains.localhost.protocol }}://authentik.{{ domains.localhost.base_domain }}"

    # Allow HTTP (⚠️ dev only — don't use in production)
    - name: AUTHENTIK_INSECURE
      value: "true"
    # Secret key for session encryption and security
    - name: AUTHENTIK_SECRET_KEY
      valueFrom:
        secretKeyRef:
          name: urbalurba-secrets
          key: AUTHENTIK_SECRET_KEY
    # PostgreSQL password
    - name: AUTHENTIK_POSTGRESQL__PASSWORD
      valueFrom:
        secretKeyRef:
          name: urbalurba-secrets
          key: AUTHENTIK_POSTGRESQL__PASSWORD
    # CSRF trusted origins for external domain access
    # DYNAMICALLY GENERATED from protected_services and domains configuration
    # Allows admin UI access via all configured domains
    - name: AUTHENTIK_WEB__CSRF_TRUSTED_ORIGINS
      value: |
        {% set csrf_origins = [] %}
        {% for domain_type, domain_config in domains.items() %}
          {% if domain_config.enabled %}
            {% for service in protected_services %}
              {% if domain_type in service.domains or service.domains == "auto" %}
                {% set _ = csrf_origins.append(domain_config.protocol + "://" + service.name + "." + domain_config.base_domain) %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endfor %}
        {{ csrf_origins | join(',') }}

# Blueprint system configuration with volume mounting
blueprints:
  # List of ConfigMaps containing blueprints
  # Only keys ending with .yaml will be discovered and applied
  configMaps:
    - "test-users-groups-blueprint" # test users and groups blueprint
    - "openwebui-blueprint" # openwebui blueprint
    - "app-slot1-blueprint" # app slot 1 blueprint
    - "service-protection-blueprint" # DYNAMICALLY GENERATED service protection blueprint

# Authentik server configuration with blueprint volume mounting
server:
  # Ingress configuration
  # NOTE: Ingress is now managed by separate IngressRoute (076-authentik-ingressroute.yaml)
  # This provides HostRegexp support for unified internal/external routing
  ingress:
    enabled: false  # Disabled - using separate IngressRoute for better control
    # ingressClassName: traefik  # Not needed when disabled
    # hosts:                     # Managed by IngressRoute with HostRegexp
    #   - authentik.localhost    # Pattern: authentik\..+ for multi-domain support

  # 🔴 NO /dev/shm OVERRIDE AND NO resources: HERE CAUSED urb-agents#2021 (freeverse,
  # live on Terje's Rancher Desktop cluster): authentik-worker SIGBUS-crash-looped
  # (dramatiq: "Worker with PID N exited unexpectedly (code -7)") after a large bulk
  # provisioning (230k queued tasks). Root cause, grounded in upstream's own history —
  # not independently reproduced here, no live cluster to test against:
  # goauthentik/authentik's prometheus multiprocess metrics (django-prometheus +
  # prometheus_client's MultiProcessValue, lifecycle/gunicorn.conf.py) write
  # `authentik_prometheus_tmp` files under /dev/shm, and multiple independent upstream
  # reports (goauthentik/authentik#10768, #16386, #22856, #25876 — the last confirming
  # this still recurs as of 2026.8.1, so a version bump alone would not fix it) describe
  # exactly this failure mode: the default Kubernetes 64Mi tmpfs fills, and a process
  # writing to a full tmpfs via mmap gets SIGBUS, not a normal write error. A separate,
  # independent third-party report (d-buckner/bloud#267) describes the identical crash
  # on authentik-SERVER's gunicorn workers for the same reason — this is not
  # worker-specific, so both get the fix.
  #
  # Fix: a dedicated, generously-sized /dev/shm (256Mi — 4x the 64Mi default; this
  # platform's own node sits at 49% memory per freeverse's report, so there is real
  # headroom) plus resources: sized to comfortably cover that shm allocation alongside
  # normal process memory, not just the app's own footprint. Values are a reasoned
  # starting point (in the same range Charmed Authentik's own production floor uses for
  # the server: 500m/1Gi), not load-tested against this platform — a team hitting them
  # under heavier load should raise, not assume they are final.
  resources:
    requests:
      cpu: "250m"
      memory: "512Mi"
    limits:
      cpu: "1"
      memory: "1Gi"

  # Blueprint volume configuration for automatic discovery
  volumes:
    # Mount blueprint ConfigMaps as volumes for automatic discovery
    - name: test-users-groups-blueprint
      configMap:
        name: test-users-groups-blueprint
    - name: openwebui-blueprint
      configMap:
        name: openwebui-blueprint
    - name: app-slot1-blueprint
      configMap:
        name: app-slot1-blueprint
    - name: service-protection-blueprint
      configMap:
        name: service-protection-blueprint
    - name: dshm
      emptyDir:
        medium: Memory
        sizeLimit: 256Mi
  volumeMounts:
    # Mount blueprints to /blueprints/ directory for discovery
    - name: test-users-groups-blueprint
      mountPath: /blueprints/test-users-groups
      readOnly: true
    - name: openwebui-blueprint
      mountPath: /blueprints/openwebui
      readOnly: true
    - name: app-slot1-blueprint
      mountPath: /blueprints/app-slot1
      readOnly: true
    - name: service-protection-blueprint
      mountPath: /blueprints/service-protection
      readOnly: true
    - name: dshm
      mountPath: /dev/shm

# Worker configuration with blueprint volume mounting and metrics
worker:
  enabled: true
  # Enable metrics for better observability of background tasks
  metrics:
    enabled: true
    # Optional: Enable ServiceMonitor for Prometheus scraping
    serviceMonitor:
      enabled: false  # Set to true if using Prometheus Operator

  # 🔴 SAME FIX AS server: ABOVE, URB-AGENTS#2021 — see that block's own comment for the
  # full root-cause story. This is the container that actually crash-looped in the
  # original report (dramatiq workers, not gunicorn).
  #
  # 🔴 LIMIT RAISED 1Gi -> 1.5Gi, URB-AGENTS#2021 PART 2 (freeverse, same live cluster):
  # once the SIGBUS fix above let the worker survive, it ran for ~17 minutes draining a
  # real backlog (a bulk provisioning's leftover tasks) at ~200 tasks/min, then hit this
  # limit and got OOMKilled (exit -9). Confirmed from authentik/dramatiq's own source:
  # there is no per-process memory ceiling or task-count-based respawn knob (Celery's
  # old `max_tasks_per_child` was removed when authentik migrated off Celery to dramatiq,
  # 2025.07.28 PR #13492, and dramatiq itself has no equivalent) — concurrency
  # (worker.processes/threads, left at their defaults of 1/2 here, not touched) is the
  # only other lever, and lowering it trades routine throughput for a backlog scenario
  # that the version bump below should make much rarer. 1.5Gi is a reasoned margin given
  # the node sits at 49% memory per freeverse's own report, not load-tested against a
  # backlog this size recurring — raise further if it recurs.
  resources:
    requests:
      cpu: "100m"
      memory: "256Mi"
    limits:
      cpu: "1"
      memory: "1.5Gi"

  # Blueprint volume configuration for automatic discovery
  volumes:
    # Mount blueprint ConfigMaps as volumes for automatic discovery
    - name: test-users-groups-blueprint
      configMap:
        name: test-users-groups-blueprint
    - name: openwebui-blueprint
      configMap:
        name: openwebui-blueprint
    - name: app-slot1-blueprint
      configMap:
        name: app-slot1-blueprint
    - name: service-protection-blueprint
      configMap:
        name: service-protection-blueprint
    - name: dshm
      emptyDir:
        medium: Memory
        sizeLimit: 256Mi
  volumeMounts:
    # Mount blueprints to /blueprints/ directory for discovery
    - name: test-users-groups-blueprint
      mountPath: /blueprints/test-users-groups
      readOnly: true
    - name: openwebui-blueprint
      mountPath: /blueprints/openwebui
      readOnly: true
    - name: app-slot1-blueprint
      mountPath: /blueprints/app-slot1
      readOnly: true
    - name: service-protection-blueprint
      mountPath: /blueprints/service-protection
      readOnly: true
    - name: dshm
      mountPath: /dev/shm

# Disable built-in Postgres/Redis (using external services)
postgresql:
  enabled: false
redis:
  enabled: false
