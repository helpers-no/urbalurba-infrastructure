# 072-oauth2-proxy-middleware.yaml.j2
#
# 🔴 NEVER WRITE JINJA SYNTAX IN A COMMENT IN THIS FILE.
#
# A `#` line is a YAML comment. It is NOT a Jinja comment. Ansible renders this
# file as text and never sees YAML, so Jinja parses every line including the
# ones starting with `#`.
#
# On 2026-09-18 the header here explained a previous bug by quoting the loop it
# had replaced. The quoted loop-open tag had no loop expression, so Jinja failed
# on line 5 with "Expected an expression, got 'end of statement block'" and never
# reached line 37. A comment describing a Jinja bug was itself a Jinja bug, and
# it broke the release that fixed the first one.
#
# Describe template constructs in prose. If syntax must be shown, use a Jinja
# comment block, not a YAML one.
#
# 🔴 AND NO JINJA BLOCK TAG MAY END A LINE.
#
# Ansible sets trim_blocks=yes, which swallows the newline after a block tag, so
# such a line merges with the one below it. That produced "mapping values are not
# allowed here" when the host match was built with a loop. The tester isolated it
# exactly: the other route used the same construct but was followed by plain
# text, so its newline survived and it did not error.
#
# The host match is therefore a single expression using `join`, not a loop. An
# expression is not a block tag, so trim_blocks cannot apply to it, and `join`
# is plain semantics that can be unit-tested without Jinja.
#
# The Traefik ForwardAuth middleware that puts a service behind the gate, plus
# the unauthenticated route that lets the sign-in round trip complete.
#
# Template variables (from the setup playbook):
#   oauth2_protected  list of {name, namespace, service, port, hosts}
#
# 🔵 ONE MIDDLEWARE PER NAMESPACE, AND THAT IS DELIBERATE.
#
# Traefik's `allowCrossNamespace` defaults to false and this repo does not set
# it, so an IngressRoute in namespace `dagster` cannot REFERENCE a Middleware
# object in `default`. PLAN-service-oauth2-proxy Phase 2.4 left three options
# open; this is option 3, and it needs no global switch.
#
# What crosses namespaces freely is the forwardAuth ADDRESS, because that is a
# URL resolved by cluster DNS rather than a Traefik object reference — exactly
# how 077-authentik-forward-auth-middleware.yaml already points at
# authentik-server.authentik.svc.cluster.local from the `default` namespace.
# So: the Middleware lives beside the service it protects, and points across.
{% for svc in oauth2_protected %}
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: oauth2-forward-auth
  namespace: {{ svc.namespace }}
  labels:
    app: oauth2-proxy
    component: forward-auth-middleware
    urbalurba.io/generated-by: oauth2-proxy
  annotations:
    urbalurba.io/description: "Requires an oauth2-proxy session; generated, do not hand-edit"
spec:
  forwardAuth:
    # A URL, not an object reference — this is why no allowCrossNamespace is needed.
    # 🔴 THE ROOT, NOT /oauth2/auth. See the long note in
    # 072-oauth2-proxy-deployment.yaml.j2: /oauth2/auth answers 401 by design and
    # Traefik relays it, so an anonymous visitor was never offered a login. The
    # root is the normal-path handler, which answers 302 to the provider when
    # unauthenticated and 202 (from the static upstream) when authenticated.
    address: http://oauth2-proxy.oauth2-proxy.svc.cluster.local:4180/
    trustForwardHeader: true
    authResponseHeaders:
      - X-Auth-Request-User
      - X-Auth-Request-Email
---
# The API gate. Same check, different answer.
#
# 🔴 A SINGLE-PAGE APP MUST GET 401, NOT 302, AND THE ROOT CANNOT GIVE IT ONE.
#
# The tester measured this on 2026-09-18: with the middleware pointing at the
# root, the gate logs every check as `GET /` regardless of what the visitor
# asked for, because ForwardAuth sends its own subrequest. So the gate cannot
# see the real path and --api-route can never match it. The fix that made an
# anonymous page load redirect correctly is the same thing that makes an
# oauth2-proxy flag unable to distinguish API paths.
#
# So the distinction moves to Traefik, where the path IS known, and uses the two
# endpoints the gate already offers:
#
#   /            normal-path handler  -> 302 to the provider   (a human)
#   /oauth2/auth auth-check handler   -> 401 with no Location   (an XHR)
#
# A browser cannot follow a cross-origin redirect to a login page, so an XHR
# that receives a 302 fails opaquely or parses the provider's HTML as JSON.
# Dagster's UI is a single-page app talking to /graphql and hit exactly that.
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: oauth2-forward-auth-api
  namespace: {{ svc.namespace }}
  labels:
    app: oauth2-proxy
    component: forward-auth-middleware-api
    urbalurba.io/generated-by: oauth2-proxy
  annotations:
    urbalurba.io/description: "Requires a session and answers 401 rather than redirecting; generated, do not hand-edit"
spec:
  forwardAuth:
    address: http://oauth2-proxy.oauth2-proxy.svc.cluster.local:4180/oauth2/auth
    trustForwardHeader: true
    authResponseHeaders:
      - X-Auth-Request-User
      - X-Auth-Request-Email
---
# The protected route. Host-specific on purpose: HostRegexp(`name\..+`) matches
# EVERY domain, which is how a wildcard tunnel publishes services nobody
# declared — see PLAN-service-exposure-opt-in. Listing the hosts means an
# undeclared hostname matches nothing.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ svc.name }}-oauth2-protected
  namespace: {{ svc.namespace }}
  labels:
    app: {{ svc.name }}
    type: protected
    protection: oauth2-proxy
    urbalurba.io/generated-by: oauth2-proxy
  annotations:
    urbalurba.io/description: "{{ svc.name }} behind oauth2-proxy; generated, do not hand-edit"
spec:
  entryPoints:
    - web
  routes:
{% for pattern in svc.api_routes | default([]) %}
    - match: Host(`{{ svc.hosts | join('`) || Host(`') }}`) && PathRegexp(`{{ pattern }}`)
      kind: Rule
      priority: 25
      middlewares:
        - name: oauth2-forward-auth-api
          namespace: {{ svc.namespace }}
      services:
        - name: {{ svc.service }}
          port: {{ svc.port }}
{% endfor %}
    - match: Host(`{{ svc.hosts | join('`) || Host(`') }}`)
      kind: Rule
      priority: 20
      middlewares:
        - name: oauth2-forward-auth
          namespace: {{ svc.namespace }}
      services:
        - name: {{ svc.service }}
          port: {{ svc.port }}
{% endfor %}
{% for svc in oauth2_protected %}
---
# 🔴 /oauth2/ MUST NOT BE AUTHENTICATED, or the sign-in cannot complete — the
# callback would itself require a session. Priority 30 beats the protected rule's
# 20, so it wins for these paths.
#
# ⚠️ AND IT LIVES IN THE oauth2-proxy NAMESPACE, NOT THE SERVICE'S.
# An earlier draft put it beside the protected route and pointed it at
# `services: {name: oauth2-proxy, namespace: oauth2-proxy}` — which is exactly
# the cross-namespace OBJECT reference that allowCrossNamespace forbids, and so
# contradicted the reason this file uses per-namespace middlewares at all.
#
# Traefik aggregates IngressRoutes from every namespace into one routing table,
# so a route may live anywhere and still match this host. Putting it here makes
# the Service reference local, and no object reference crosses a namespace
# anywhere in this file.
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: {{ svc.name }}-oauth2-callback
  namespace: oauth2-proxy
  labels:
    app: oauth2-proxy
    component: callback-route
    protects: {{ svc.name }}
    urbalurba.io/generated-by: oauth2-proxy
  annotations:
    urbalurba.io/description: "Unauthenticated /oauth2/ path for {{ svc.name }}; generated, do not hand-edit"
spec:
  entryPoints:
    - web
  routes:
    - match: Host(`{{ svc.hosts | join('`) || Host(`') }}`) && PathPrefix(`/oauth2/`)
      kind: Rule
      priority: 30
      services:
        - name: oauth2-proxy
          port: 4180
{% endfor %}
