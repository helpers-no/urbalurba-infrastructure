# 820-cloudflare-tunnel-base.yaml.j2
#
# Token-based Cloudflare tunnel deployment. Templated so one installation can
# run more than one named tunnel (test/prod/...) without their Deployments,
# pod labels or Secret keys colliding — see
# ansible/playbooks/820-deploy-network-cloudflare-tunnel.yml, which renders
# this with cf_deployment_name/cf_pod_label/cf_token_key computed from an
# optional cf_env (empty cf_env renders byte-identical to the original static
# manifest: cloudflare-tunnel / cloudflared / CLOUDFLARE_TUNNEL_TOKEN).
#
# SECRET-VERSION: pending — reads urbalurba-secrets, which `uis secrets apply`
# re-syncs, so the value CAN change without this manifest changing. Needs the
# pod-template annotation before a re-applied secret reaches a running pod.
# See PLAN-secret-version-propagation.
# The tunnel token is read from urbalurba-secrets via secretKeyRef.
# All routing is configured in the Cloudflare dashboard, not here.
#
# Rendered and applied by: ansible/playbooks/820-deploy-network-cloudflare-tunnel.yml
# (never `kubectl apply -f` this file directly — {{ cf_deployment_name }} etc.
# are Jinja placeholders, not valid YAML on their own).

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ cf_deployment_name }}
  namespace: default
  labels:
    app: {{ cf_pod_label }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: {{ cf_pod_label }}
  template:
    metadata:
      labels:
        app: {{ cf_pod_label }}
    spec:
      containers:
      - name: cloudflared
        image: cloudflare/cloudflared:latest
        args:
        - tunnel
        - --no-autoupdate
        - --metrics
        - 0.0.0.0:2000
        - run
        env:
        - name: TUNNEL_TOKEN
          valueFrom:
            secretKeyRef:
              name: urbalurba-secrets
              key: {{ cf_token_key }}
        ports:
        - containerPort: 2000
          name: metrics
          protocol: TCP
        livenessProbe:
          httpGet:
            path: /ready
            port: 2000
          initialDelaySeconds: 10
          periodSeconds: 30
        readinessProbe:
          httpGet:
            path: /ready
            port: 2000
          initialDelaySeconds: 5
          periodSeconds: 10
        resources:
          requests:
            memory: "64Mi"
            cpu: "50m"
          limits:
            memory: "256Mi"
            cpu: "500m"
