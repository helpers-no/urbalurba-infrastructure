# protected-services.yaml — which services require a login, and who may pass.
#
# THIS FILE IS YOURS. It is copied here once if missing and never overwritten by
# an image update, unlike the templates under .uis.secrets/secrets-config/.
#
# Edit it, then apply:
#     ./uis deploy oauth2-proxy
#
# To remove a login from everything, set `protected: []` and apply. That is a
# supported un-gate: the generated routes are deleted and the hosts are reachable
# again without a login. The gate pod stays; remove it with
# `./uis undeploy oauth2-proxy`.
#
# 🔴 THE ALLOWLIST IS WHAT MAKES THIS A CONTROL.
# oauth2-proxy accepts --email-domain=* which upstream documents as "Use * to
# authenticate any email", and most quickstart guides show exactly that. With *
# and a public provider, a gate converts "anonymous" into "anyone with an
# account" and is close to no protection at all. UIS does not offer *; name the
# addresses.
#
# 🔵 The credentials do NOT go here — they are secrets and belong in
# .uis.secrets/secrets-config/00-common-values.env.template:
#     OAUTH2_PROXY_CLIENT_ID, OAUTH2_PROXY_CLIENT_SECRET, OAUTH2_PROXY_COOKIE_SECRET
#
# Docs: /docs/services/identity/oauth2-proxy

# Which provider authenticates people. One provider per installation —
# oauth2-proxy cannot offer a choice of several (upstream issue #926). If you
# need that, use Authentik.
provider: github          # github | google | oidc
issuer: ""                # required for provider: oidc only

# The parent domain session cookies are scoped to, so one sign-in covers every
# protected host beneath it.
#
# ⚠️ IT MUST BE THE APEX OF THE HOSTS BELOW, AND IT CHANGES WITH THEM. Gating
# dagster.example.com needs cookie_domain: "example.com" — a value left at
# "localhost" while the hosts moved to a real domain issues cookies the browser
# discards, and the sign-in loops with no error to explain it. Measured on
# 2026-09-18: moving one host from .localhost to a public domain required this
# line to change too.
#
# 🔵 One gate instance therefore covers ONE apex. Hosts under two different
# apex domains need two instances, or Authentik.
cookie_domain: ""

# Who may pass the gate. Their address must be the PRIMARY VERIFIED email on the
# provider account — that is the one the provider returns.
allowed_emails: []

# Which services sit behind it. A service not listed here is not gated.
#
#   name       the service's UIS name, used to name the generated objects
#   namespace  where its Kubernetes Service lives
#   service    the Kubernetes Service name (not always the same as `name`)
#   port       that Service's port
#   hosts      the EXTERNAL hostnames to gate. Named hosts, never a wildcard —
#              a regex matching every domain is how a wildcard tunnel publishes
#              services nobody declared.
#   accept_unauthenticated_pattern
#              optional, and it is a security decision rather than a setting.
#
#              🔴 A UIS service usually ships its own IngressRoute matching a
#              PATTERN — HostRegexp(`name\..+`) — so that one route works on
#              .localhost, a tailnet name, or whatever an installation puts in
#              front of Traefik. The gate matches the LITERAL hosts below.
#
#              ⚠️ Measured on a live cluster 2026-09-22: with both routes
#              present, the gated host redirects to the provider and
#              <name>.localhost and <name>.anything-else return the full UI
#              with NO LOGIN. Any Host header matching the pattern walks around
#              the gate, and nothing downstream says so.
#
#              The deploy REFUSES that by default. Set this to true only when
#              the pattern is open on purpose — a local development host, for
#              instance — and write down why beside it. It accepts that hosts
#              you have not listed reach this service unauthenticated.
#
#   api_routes optional, and required for any single-page app: path patterns
#              (regexes) that must receive a 401 rather than a redirect, because
#              browser JavaScript cannot follow a cross-origin redirect to a
#              login page — an XHR that gets a 302 fails opaquely or parses the
#              provider's HTML as JSON.
#
#              These become their own higher-priority Traefik rules using a
#              second middleware, because the gate itself cannot tell API paths
#              apart: ForwardAuth sends its own subrequest, so the gate always
#              sees `GET /` regardless of what the visitor asked for.
#
# Example — a Dagster webserver gated on its public hostname while
# dagster.localhost stays open:
#
# protected:
#   - name: dagster
#     namespace: dagster
#     service: dagster-dagster-webserver
#     port: 80
#     hosts: ["dagster.example.com"]
#     api_routes: ["^/graphql"]
#     # dagster.localhost stays open for local development, and the pattern
#     # route that serves it also serves any other unlisted host:
#     accept_unauthenticated_pattern: true
protected: []
